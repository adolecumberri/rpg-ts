{
  "compilerOptions": {
    "declaration": true,
    "lib": [
      "es6",
      "dom",
      "dom.iterable",
      "ES2017.Object"
    ],
    "module": "commonjs",
    "removeComments": true,
    "sourceMap": true,
    "target": "es6",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@rpg": [
        "src"
      ],
      "@rpg/*": [
        "src/*"
      ],
      "@core": [
        "worldTest/core"
      ],
      "@core/*": [
        "worldTest/core/*"
      ]
    },
    "types": [
      "jest"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.ts",
    "proyecto_viejo/**/*"
  ]
}
