{
  "name": "rpg-ts",
  "version": "1.7.5",
  "description": "rpg utilities in TS",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.umd.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --fix --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "world:test": "tsx worldTest/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run lint && tsc --project tsconfig.build.json && npm run bundle",
    "bundle": "rollup -c",
    "prepublishOnly": "npm run lint:fix && npm run build && npm test",
    "release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adolecumberri/rpg-ts.git"
  },
  "author": "Adolfo Reyes Agustin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adolecumberri/rpg-ts/issues"
  },
  "homepage": "https://github.com/adolecumberri/rpg-ts#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.3.1",
    "@typescript-eslint/eslint-plugin": "^5.48.1",
    "@typescript-eslint/parser": "^5.48.1",
    "eslint": "^8.31.0",
    "eslint-config-google": "^0.14.0",
    "jest": "^28.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.7",
    "rollup": "^3.10.0",
    "semantic-release": "^24.1.0",
    "ts-jest": "^28.0.3",
    "tsx": "^4.22.4",
    "typescript": "^4.7.2"
  }
}
